# RouterOS 7 REST API settings
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_PROTOCOL=https
MIKROTIK_USERNAME=hotspot-app
MIKROTIK_PASSWORD=replace-with-a-strong-password

# Web app login: setup-windows.bat creates the first account.
# Run `npm run setup-auth` again to add accounts, up to five total.
APP_USERS_JSON=[]
APP_SESSION_SECRET=
APP_COOKIE_SECURE=false

# Keep the app on this computer by default. Change only for trusted LAN access.
HOST=127.0.0.1
PORT=3000
